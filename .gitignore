# Rust build output (generated by cargo; not committed — Cargo.lock is kept).
/target/
**/*.rs.bk
*.pdb

# Coverage / profiling artifacts.
*.profraw
/coverage/
/llvm-cov-target/

# Environment / secrets (tokens and endpoints are passed via env, never committed).
.env
.env.*

# Internal planning notes (not part of the published SDK).
/planning/

# Local tooling / editor config.
.claude/
.idea/
.vscode/
*.iml

# OS junk.
.DS_Store
Thumbs.db

# scala-cli build caches (tools/lf-oracle).
.bsp/
.scala-build/

# The both-providers TLS check is its own crate outside the workspace.
/tools/tls-providers/target/
/tools/tls-providers/Cargo.lock

# cargo-fuzz output.
/fuzz/target/
/fuzz/corpus/
/fuzz/artifacts/
/fuzz/Cargo.lock
